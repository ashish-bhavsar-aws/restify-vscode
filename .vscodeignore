# Exclude source
src/**

# Exclude dependencies (bundled into dist/ by webpack)
node_modules/**
!node_modules/your-runtime-deps/**

# Exclude tests and test artifacts
test/**
test-results/**
playwright-report/**
video/**

# Exclude dev/CI tooling
.vscode/**
.vscodeignore
.github/**
.opencode/**
.claude/**
scripts/**
dev/**
server/**
output.zip
file.js

# Exclude build config and docs not needed at runtime
tsconfig.json
vitest.config.ts
eslint.config.*
.eslintignore
.eslintrc.json
.gitignore
GUARDRAILS.md
ROADMAP.md
UI_IMPRPVE.md

# Exclude logs and sourcemaps (keep the package small)
**/*.map
*.log
