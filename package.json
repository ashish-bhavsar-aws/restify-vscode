{
  "name": "restify-client",
  "displayName": "Restify — API Client",
  "description": "A full-featured REST, SOAP/WSDL, and GraphQL API client for Visual Studio Code. Send and debug HTTP requests, organize collections, manage environments and variables, authenticate with OAuth 2.0 / JWT / Bearer / Basic / AWS SigV4 / Digest / Hawk, validate JSON responses against JSON Schema, query bodies with JSONPath, persist cookies, run pre-request and post-response scripts, follow redirects, and generate code in many languages.",
  "keywords": [
    "api",
    "api client",
    "rest",
    "rest client",
    "http",
    "http client",
    "soap",
    "wsdl",
    "graphql",
    "websocket",
    "json",
    "jsonpath",
    "json schema",
    "openapi",
    "swagger",
    "oauth2",
    "oauth",
    "jwt",
    "bearer token",
    "aws signature",
    "digest auth",
    "postman",
    "insomnia",
    "thunder client",
    "collections",
    "environments",
    "variables",
    "curl",
    "codegen",
    "api testing",
    "testing"
  ],
  "version": "1.0.26",
  "license": "MIT",
  "publisher": "AshishBhavsar",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashish-bhavsar-aws/restify-vscode.git"
  },
  "homepage": "https://github.com/ashish-bhavsar-aws/restify-vscode",
  "bugs": {
    "url": "https://github.com/ashish-bhavsar-aws/restify-vscode/issues"
  },
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "restify-container",
          "title": "Restify API Client",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "restify-panel-container",
          "title": "Restify",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "restify-container": [
        {
          "id": "restify-history",
          "name": "History",
          "type": "webview"
        },
        {
          "id": "restify-collections",
          "name": "Collections",
          "type": "webview"
        },
        {
          "id": "restify-openapi",
          "name": "API Explorer",
          "type": "webview"
        }
      ],
      "restify-panel-container": [
        {
          "id": "restify-activity",
          "name": "Activity",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "restify.openMain",
        "title": "Open Restify",
        "category": "Restify"
      },
      {
        "command": "restify.newRequest",
        "title": "New Request",
        "category": "Restify",
        "icon": "$(add)"
      },
      {
        "command": "restify.newCollection",
        "title": "New Collection",
        "category": "Restify",
        "icon": "$(add)"
      },
      {
        "command": "restify.importCollection",
        "title": "Import Collection",
        "category": "Restify",
        "icon": "$(cloud-download)"
      },
      {
        "command": "restify.importCurl",
        "title": "Paste cURL",
        "category": "Restify",
        "icon": "$(clippy)"
      },
      {
        "command": "restify.sendRequest",
        "title": "Send Request",
        "category": "Restify",
        "icon": "$(play)"
      },
      {
        "command": "restify.searchCollections",
        "title": "Search in Collections",
        "category": "Restify",
        "icon": "$(search)"
      },
      {
        "command": "restify.exportAllCollections",
        "title": "Export All Collections",
        "category": "Restify",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "restify.openEnvironments",
        "title": "Manage Environments",
        "category": "Restify",
        "icon": "$(gear)"
      },
      {
        "command": "restify.openHttpFile",
        "title": "Open .http File",
        "category": "Restify",
        "icon": "$(open-file)"
      },
      {
        "command": "restify.exportRequestToHttp",
        "title": "Export Request to .http",
        "category": "Restify",
        "icon": "$(export)"
      },
      {
        "command": "restify.showHttpLog",
        "title": "Show HTTP Log",
        "category": "Restify",
        "icon": "$(output)"
      },
      {
        "command": "restify.startMockServer",
        "title": "Start Mock Server",
        "category": "Restify",
        "icon": "$(play)"
      },
      {
        "command": "restify.stopMockServer",
        "title": "Stop Mock Server",
        "category": "Restify",
        "icon": "$(circle-slash)"
      },
      {
        "command": "restify.generateDocs",
        "title": "Generate API Documentation",
        "category": "Restify",
        "icon": "$(file-text)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "restify.newRequest",
          "when": "view == restify-history",
          "group": "navigation"
        },
        {
          "command": "restify.newCollection",
          "when": "view == restify-collections",
          "group": "navigation"
        },
        {
          "command": "restify.importCollection",
          "when": "view == restify-collections",
          "group": "navigation"
        },
        {
          "command": "restify.importCurl",
          "when": "view == restify-collections",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "restify.openHttpFile",
          "when": "resourceExtname == .http",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "restify.openHttpFile",
          "when": "resourceExtname == .http"
        }
      ]
    },
    "configuration": {
      "title": "Restify",
      "properties": {
        "restify.proxy": {
          "type": "object",
          "description": "Proxy settings for Restify requests",
          "default": {},
          "properties": {
            "http.proxyAuthorization": {
              "type": [
                "string",
                "null"
              ],
              "description": "The header value for proxy authorization."
            },
            "http.proxy": {
              "type": "string",
              "description": "The proxy setting to use."
            },
            "http.noProxy": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Hosts that should not use the proxy."
            }
          }
        },
        "restify.certificates": {
          "type": "object",
          "description": "mTLS Certificates mapping (Hostname to File Paths)",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "certPath": {
                "type": "string",
                "description": "Absolute path to client certificate"
              },
              "keyPath": {
                "type": "string",
                "description": "Absolute path to client private key"
              },
              "caPath": {
                "type": "string",
                "description": "Optional: Path to CA certificate"
              }
            }
          }
        }
      }
    }
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@types/node": "^20.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vscode/webview-ui-toolkit": "^1.2.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.8.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.4.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-html": "^6.0.0",
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-xml": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/theme-one-dark": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "exceljs": "^4.4.0",
    "https-proxy-agent": "^9.0.0",
    "lokijs": "^1.5.12",
    "node-fetch": "^2.6.9",
    "node-forge": "^1.4.0",
    "react-pdf": "^10.4.1",
    "styled-components": "^6.4.3",
    "ws": "^8.21.3"
  },
  "overrides": {
    "glob": "^8.1.0",
    "rimraf": "^4.0.0",
    "dompurify": "^2.3.10",
    "uuid": "^11.1.1"
  },
  "scripts": {
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "build": "npm install && webpack --mode production",
    "prepackage": "rm -rf dist && NODE_OPTIONS=\"--max-old-space-size=8192\" npm run build",
    "package": "vsce package",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "lint:unused": "eslint . --ext .ts,.tsx --rule 'unused-imports/no-unused-imports: error' --rule '@typescript-eslint/no-unused-vars: error'",
    "guardrails": "node scripts/check-guardrails.mjs",
    "test:unit": "vitest run"
  },
  "activationEvents": [
    "onStartupFinished"
  ]
}
