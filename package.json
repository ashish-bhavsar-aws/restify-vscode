{
  "name": "restify-client",
  "displayName": "Restify — API Client",
  "description": "A powerful REST API client for VS Code with collections, history, and environment support",
  "version": "1.0.15",
  "publisher": "AshishBhavsar",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "restify-container",
          "title": "Restify API Client",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "restify-container": [
        {
          "id": "restify-history",
          "name": "History",
          "type": "webview"
        },
        {
          "id": "restify-collections",
          "name": "Collections",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "restify.openMain",
        "title": "Open Restify",
        "category": "Restify"
      },
      {
        "command": "restify.newRequest",
        "title": "New Request",
        "category": "Restify",
        "icon": "$(add)"
      },
      {
        "command": "restify.newCollection",
        "title": "New Collection",
        "category": "Restify",
        "icon": "$(add)"
      },
      {
        "command": "restify.importCollection",
        "title": "Import Collection",
        "category": "Restify",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "restify.newRequest",
          "when": "view == restify-history",
          "group": "navigation"
        },
        {
          "command": "restify.newCollection",
          "when": "view == restify-collections",
          "group": "navigation"
        },
        {
          "command": "restify.importCollection",
          "when": "view == restify-collections",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Restify",
      "properties": {
        "restify.proxy": {
          "type": "object",
          "description": "Proxy settings for Restify requests",
          "default": {},
          "properties": {
            "http.proxyAuthorization": {
              "type": [
                "string",
                "null"
              ],
              "description": "The header value for proxy authorization."
            },
            "http.proxy": {
              "type": "string",
              "description": "The proxy setting to use."
            },
            "http.noProxy": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Hosts that should not use the proxy."
            }
          }
        },
        "restify.certificates": {
          "type": "object",
          "description": "mTLS Certificates mapping (Hostname to File Paths)",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "certPath": {
                "type": "string",
                "description": "Absolute path to client certificate"
              },
              "keyPath": {
                "type": "string",
                "description": "Absolute path to client private key"
              },
              "caPath": {
                "type": "string",
                "description": "Optional: Path to CA certificate"
              }
            }
          }
        }
      }
    }
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vscode/webview-ui-toolkit": "^1.2.0",
    "css-loader": "^7.1.4",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.8.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.4.0",
    "typescript": "^5.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "https-proxy-agent": "^9.0.0",
    "lokijs": "^1.5.12",
    "node-fetch": "^2.6.9"
  },
  "overrides": {
    "glob": "^8.1.0",
    "rimraf": "^4.0.0"
  },
  "scripts": {
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "package": "vsce package",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "lint:unused": "eslint . --ext .ts,.tsx --rule 'unused-imports/no-unused-imports: error' --rule '@typescript-eslint/no-unused-vars: error'"
  }
}
