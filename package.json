{
  "name": "restify-client",
  "displayName": "Restify — API Client",
  "description": "A powerful REST API client for VS Code with collections, history, and environment support",
  "version": "1.0.2",
  "publisher": "AshishBhavsar",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:restify-history",
    "onView:restify-collections",
    "onView:restify-environments",
    "onCommand:restify.openMain",
    "onCommand:restify.newRequest"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "restify-container",
          "title": "Restify API Client",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "restify-container": [
        {
          "id": "restify-history",
          "name": "History",
          "type": "webview"
        },
        {
          "id": "restify-collections",
          "name": "Collections",
          "type": "webview"
        },
        {
          "id": "restify-environments",
          "name": "Environments",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "restify.openMain",
        "title": "Open Restify",
        "category": "Restify"
      },
      {
        "command": "restify.newRequest",
        "title": "New Request",
        "category": "Restify",
        "icon": "media/new-request.svg"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "restify.newRequest",
          "when": "view == restify-history",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Restify",
      "properties": {
        "restify.proxy": {
          "type": "object",
          "description": "Proxy settings for Restify requests",
          "default": {},
          "properties": {
            "http.proxyAuthorization": {
              "type": [
                "string",
                "null"
              ],
              "description": "The header value for proxy authorization."
            },
            "http.proxy": {
              "type": "string",
              "description": "The proxy setting to use."
            },
            "http.noProxy": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Hosts that should not use the proxy."
            }
          }
        },
        "restify.certificates": {
          "type": "object",
          "description": "mTLS Certificates mapping (Hostname to File Paths)",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "certPath": {
                "type": "string",
                "description": "Absolute path to client certificate"
              },
              "keyPath": {
                "type": "string",
                "description": "Absolute path to client private key"
              },
              "caPath": {
                "type": "string",
                "description": "Optional: Path to CA certificate"
              }
            }
          }
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.80.0",
    "@vscode/webview-ui-toolkit": "^1.2.0",
    "css-loader": "^7.1.4",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.8.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.4.0",
    "typescript": "^5.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "https-proxy-agent": "^9.0.0",
    "lokijs": "^1.5.12",
    "node-fetch": "^2.6.9"
  },
  "scripts": {
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "package": "vsce package"
  }
}
